# OPTIONAL - only if live video fails on some networks. Paste the real values into the Streamlit Cloud "Secrets" box
# (App settings > Secrets). NEVER commit a real secrets.toml to GitHub.
[turn]
urls = ["turn:YOUR-TURN-HOST:3478", "turns:YOUR-TURN-HOST:5349"]
username = "YOUR-USERNAME"
credential = "YOUR-CREDENTIAL"
